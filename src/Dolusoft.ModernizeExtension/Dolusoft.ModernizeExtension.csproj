<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseVSSDK>true</UseVSSDK>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>true</DeployExtension>
    <RootNamespace>Dolusoft.ModernizeExtension</RootNamespace>
    <AssemblyName>Dolusoft.ModernizeExtension</AssemblyName>
  </PropertyGroup>

  <!-- F5 → Experimental VS Instance başlatır -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <!-- VS 2022 SDK meta-package — provides all Shell, Interop, MEF refs -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
    <!-- Roslyn workspace API for live VS workspace access -->
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.14.0" />
    <!-- Explicit ref gerekli — transitive deps SDK-style projede derlemeye dahil edilmez -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="Commands\ModernizeCommands.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <!-- VSSDK pipeline'ının manifest'i bulması için explicit None item şart -->
  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded WPF resources — served via pack URI from the Image Service -->
    <Resource Include="Resources\modernize-16.png" />
    <Resource Include="Resources\modernize-dark-16.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loose files included in the VSIX package -->
    <Content Include="Resources\modernize-32.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\modernize-dark-32.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Image manifest: registered at runtime via ProvideImageManifestAttribute -->
    <Content Include="Resources\ModernizeImages.imagemanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
